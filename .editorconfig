root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyw}]
indent_style = space
indent_size = 4

[*.{js,cjs,mjs,json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows 批处理必须使用 CRLF，否则 cmd.exe 解析异常
[*.{bat,cmd}]
end_of_line = crlf
